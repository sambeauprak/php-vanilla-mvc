{% extends "layout.html.twig" %}

{% block main %}
	<form action="{{ variable is defined ? '/blocks/' ~ block.id ~ '/variables/update/' ~ variable.id : '/blocks/' ~ block.id ~ '/variables/submit' }}" method="POST">
		<div class="space-y-12">
			<div class="border-b border-gray-900/10 pb-12 dark:border-white/10">
				<h2 class="text-base/7 font-semibold text-gray-900 dark:text-white">{{ variable is defined ? "Modification d'une variable" : "Ajout d'une nouvelle variable" }}</h2>
				<p class="mt-1 text-sm/6 text-gray-600 dark:text-gray-400">Block : {{ block.name }}</p>

				<div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
					<div class="sm:col-span-3">
						<label for="name" class="block text-sm/6 font-medium text-gray-900 dark:text-white">Nom</label>
						<div class="mt-2">
							<div class="flex items-center rounded-md bg-white pl-3 outline-1 -outline-offset-1 outline-gray-300 focus-within:outline-2 focus-within:-outline-offset-2 focus-within:outline-indigo-600 dark:bg-white/5 dark:outline-white/10 dark:focus-within:outline-indigo-500">
								<input id="name" type="text" name="name" placeholder="Nom de la variable" value="{{ variable is defined ? variable.name : '' }}" class="block min-w-0 grow bg-white py-1.5 pr-3 pl-1 text-base text-gray-900 placeholder:text-gray-400 focus:outline-none sm:text-sm/6 dark:bg-transparent dark:text-white dark:placeholder:text-gray-500"/>
							</div>
						</div>
					</div>

					<div class="sm:col-span-6">
						<label for="value" class="block text-sm/6 font-medium text-gray-900 dark:text-white">Valeur</label>
						<div class="mt-2">
							<div class="flex items-start rounded-md bg-white pl-3 outline-1 -outline-offset-1 outline-gray-300 focus-within:outline-2 focus-within:-outline-offset-2 focus-within:outline-indigo-600 dark:bg-white/5 dark:outline-white/10 dark:focus-within:outline-indigo-500">
								<textarea id="value" name="value" rows="4" placeholder="Valeur de la variable" class="block min-w-0 grow bg-white py-1.5 pr-3 pl-1 text-base text-gray-900 placeholder:text-gray-400 focus:outline-none sm:text-sm/6 dark:bg-transparent dark:text-white dark:placeholder:text-gray-500">{{ variable is defined ? variable.value : '' }}</textarea>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="mt-6 flex items-center justify-end gap-x-6">
			<a href="/blocks/{{ block.id }}/variables" class="text-sm/6 font-semibold text-gray-900 dark:text-white">Annuler</a>
			<button type="submit" class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:bg-indigo-500 dark:shadow-none dark:focus-visible:outline-indigo-500">{{ variable is defined ? "Mettre à jour" : "Créer" }}</button>
		</div>
	</form>
{% endblock %}
